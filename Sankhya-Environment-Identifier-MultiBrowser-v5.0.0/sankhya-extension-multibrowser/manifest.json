{
  "manifest_version": 3,
  "name": "Sankhya Environment Identifier",
  "version": "5.0.0",
  "description": "Identifica os ambientes Sankhya de Produção e Teste. Compatível com Chrome, Edge e Firefox.",
  "permissions": [
    "tabs"
  ],
  "host_permissions": [
    "*://haiala.snk.ativy.com/*",
    "*://snkbrp01672.ativy.com/*",
    "*://snkbrt01672.ativy.com/*",
    "*://snkbrp01672.wevy.cloud/*",
    "*://snkbrt01672.wevy.cloud/*"
  ],
  "action": {
    "default_title": "Sankhya - Identificação de ambiente",
    "default_popup": "popup.html",
    "default_icon": {
      "128": "icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://haiala.snk.ativy.com/*",
        "*://snkbrp01672.ativy.com/*",
        "*://snkbrt01672.ativy.com/*",
        "*://snkbrp01672.wevy.cloud/*",
        "*://snkbrt01672.wevy.cloud/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "sankhya-environment-identifier@jnt.local",
      "strict_min_version": "128.0"
    }
  }
}
